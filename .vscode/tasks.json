{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Structure Light Desktop App",
            "type": "shell",
            "command": "python",
            "args": [
                "structure_light_desktop_app.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
